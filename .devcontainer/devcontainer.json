// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "keelson-interface-docker",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
	"features": {
		// The responder talks to a Docker daemon; docker-in-docker gives the
		// devcontainer one of its own to list and control.
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/va-h/devcontainers-features/uv:1": {}
	},
	"runArgs": [
		"--network=host"
	],
	"postCreateCommand": "uv venv && uv pip install -e '.[dev,proto]'"
}

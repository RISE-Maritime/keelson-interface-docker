# gid of the HOST's `docker` group, for Linux hosts. The image runs as uid 10001,
# which is not in that group and therefore cannot open a root:docker 0660
# /var/run/docker.sock; the compose file adds it as a supplementary group.
#
#   echo "DOCKER_GID=$(getent group docker | cut -d: -f3)" > .env
#
# The value is host-specific -- 999 on Debian/Ubuntu, something else on
# RHEL-family. It DEFAULTS to 0 rather than being required, so that
# docker-compose.dev.yml (macOS, runs as root) can be reached: Compose
# interpolates every -f file before merging, so a required-variable guard in the
# base file would abort before the override was ever read. A wrong or missing
# value is caught at startup by the responder itself, which names this variable.
#
# NOT NEEDED on macOS / Docker Desktop -- use the dev override instead.
DOCKER_GID=999
